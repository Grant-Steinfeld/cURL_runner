{
  "name": "curl-runner-core",
  "version": "1.2.0",
  "description": "A Node.js application to run cURL scripts from .sh files",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "src/",
    "scripts/",
    "README.md",
    "example.log"
  ],
  "scripts": {
    "start": "bash scripts/run_all.sh",
    "dev": "bash scripts/run_all.sh",
    "run:all": "bash scripts/run_all.sh",
    "run:parallel": "bash scripts/run_parallel.sh",
    "run:concurrent": "bash scripts/run_concurrent.sh",
    "run:script": "bash scripts/run_script.sh",
    "run:list": "bash scripts/list_scripts.sh",
    "run:log": "bash scripts/run_with_log.sh",
    "run:log:background": "bash scripts/run_with_log_background.sh",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "test:coverage": "c8 node --test tests/**/*.test.js",
    "test:ci": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "curl",
    "scripts",
    "automation",
    "http"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "c8": "^10.1.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grant-Steinfeld/cURL_runner.git"
  },
  "bugs": {
    "url": "https://github.com/Grant-Steinfeld/cURL_runner/issues"
  },
  "homepage": "https://www.npmjs.com/package/curl-runner-core",
  "publishConfig": {
    "access": "public"
  }
}